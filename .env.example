# Copy this file to .env.local and edit values there.
# Vite reads VITE_* values for the browser client.
# The Driftlands server reads .env and .env.local on startup.

# Client
# Explicit Socket.IO/API origin. Leave empty to use the current browser origin and Vite proxy.
VITE_SERVER_URL=

# Looperlands API used by the browser client for session identity and by the server when mirrored below.
VITE_LOOPERLANDS_API_URL=https://api.looperlands.io/api

# Legacy alias for VITE_LOOPERLANDS_API_URL.
VITE_API_URL=

# Reown Cloud project id for WalletConnect wallets such as Loopring Wallet.
VITE_WALLETCONNECT_PROJECT_ID=

# Server
# Host and port for the Socket.IO/Express server.
HOST=0.0.0.0
PORT=3000

# Comma-separated allowed browser origins for Socket.IO and API CORS.
# Leave empty to allow localhost, common LAN origins, and ngrok-free.app.
FRONTEND_ORIGIN=

# Server simulation ticks per second.
SERVER_TPS=10

# Fixed world seed. Leave empty for a random world on each server start.
SERVER_SEED=

# Optional path for persistent server progress. Local non-production runs default
# to .driftlands/world-save.json when this is empty.
SERVER_SAVE_PATH=
SERVER_SAVE_INTERVAL_MS=5000

# Optional aggregate stats storage. Local non-production runs default to
# .driftlands/analytics when this is empty.
DRIFTLANDS_ANALYTICS_PATH=
DRIFTLANDS_ANALYTICS_RETENTION_DAYS=30

# Enables debug/test helpers when true. Use 0/false/no/off to disable.
SERVER_DEBUG_MODE=1

# Settlement placement mode: candidates or free.
SERVER_SETTLEMENT_START_MODE=candidates

# Enables safer world-generation spawn constraints when true.
SERVER_SPAWN_SAFETY=0

# Looperlands API used by the Driftlands server for wallet validation and proxying.
LOOPERLANDS_API_URL=https://api.looperlands.io/api

# Force Looperlands wallet auth requirement when set to 1.
SERVER_REQUIRE_LOOPERLANDS_AUTH=0

# Discord chat logging. Prefer channel ID when the channel already exists.
# If DRIFTLANDS_DISCORD_CHANNEL_ID is empty but bot token + guild ID are set,
# the server will find or create DRIFTLANDS_DISCORD_CHANNEL_NAME.
DRIFTLANDS_DISCORD_BOT_TOKEN=
DRIFTLANDS_DISCORD_GUILD_ID=
DRIFTLANDS_DISCORD_CHANNEL_ID=
DRIFTLANDS_DISCORD_CHANNEL_NAME=driftlands-chat
DRIFTLANDS_DISCORD_CATEGORY_ID=

# Optional webhook-only fallback. Webhooks can post messages but cannot create channels.
DRIFTLANDS_DISCORD_WEBHOOK_URL=

# Optional server-only override. If set in the shell, the server loads only this env file.
# DRIFTLANDS_ENV_FILE=.env.local
