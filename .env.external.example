NODE_ENV=production
HOST=0.0.0.0
PORT=3000

SERVER_DEBUG_MODE=0
SERVER_TPS=10
SERVER_SETTLEMENT_START_MODE=candidates
SERVER_SPAWN_SAFETY=0
SERVER_REQUIRE_LOOPERLANDS_AUTH=0

# Comma-separated production admin wallets. Wallet casing does not matter.
DRIFTLANDS_ADMIN_WALLETS=0xfE49e5c384f5FddDFc52e9610BfAB3d49D86847D

SERVER_SEED=

SERVER_SAVE_PATH=.driftlands/world-save.json
SERVER_SAVE_INTERVAL_MS=5000

DRIFTLANDS_ANALYTICS_PATH=.driftlands/analytics
DRIFTLANDS_ANALYTICS_RETENTION_DAYS=30

LOOPERLANDS_API_URL=https://api.looperlands.io/api
FRONTEND_ORIGIN=https://<your-online-frontend-domain>

# Discord chat logging. Use a bot token plus either an existing channel ID,
# or a guild ID so Driftlands can find/create DRIFTLANDS_DISCORD_CHANNEL_NAME.
DRIFTLANDS_DISCORD_BOT_TOKEN=
DRIFTLANDS_DISCORD_GUILD_ID=
DRIFTLANDS_DISCORD_CHANNEL_ID=
DRIFTLANDS_DISCORD_CHANNEL_NAME=driftlands-chat
DRIFTLANDS_DISCORD_CATEGORY_ID=
DRIFTLANDS_DISCORD_WEBHOOK_URL=
