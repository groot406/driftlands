# Copy this file to /config/driftlands/.env on the Home Assistant OS host.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

SERVER_DEBUG_MODE=0
SERVER_PERF_DEBUG=1
SERVER_TPS=10
SERVER_SETTLEMENT_START_MODE=free
SERVER_SPAWN_SAFETY=0
SERVER_REQUIRE_LOOPERLANDS_AUTH=0

# Comma-separated production admin wallets. Wallet casing does not matter.
DRIFTLANDS_ADMIN_WALLETS=0xfE49e5c384f5FddDFc52e9610BfAB3d49D86847D

# Leave empty for a fresh random world on each server start.
SERVER_SEED=

# Persist settlement/world progress across container recreates.
SERVER_SAVE_PATH=/data/world-save.json
SERVER_SAVE_INTERVAL_MS=5000

LOOPERLANDS_API_URL=https://api.looperlands.io/api

# Set this to the Looperlands platform frontend origin that serves /driftlands.
FRONTEND_ORIGIN=https://<looperlands-platform-frontend-domain>
