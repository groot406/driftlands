{
  "name": "driftlands",
  "private": true,
  "version": "0.0.0",
  "description": "A cozy run-based colony strategy game about building a frontier settlement before the season turns.",
  "type": "module",
  "main": "desktop/electron/main.mjs",
  "bin": {
    "driftlands": "./scripts/hosting-tui.mjs"
  },
  "scripts": {
    "start": "npm run dev",
    "start:free": "SERVER_SETTLEMENT_START_MODE=free npm run dev",
    "dev": "concurrently \"npm:client\" \"npm:server\"",
    "dev:no-debug": "concurrently \"npm:client\" \"npm:server:no-debug\"",
    "dev:no-debug:free": "concurrently \"npm:client\" \"npm:server:no-debug:free\"",
    "dev:free": "SERVER_SETTLEMENT_START_MODE=free npm run dev",
    "test": "npm run dev",
    "test:unit": "tsx --test src/**/*.test.ts server/**/*.test.ts",
    "client": "vite",
    "server": "nodemon",
    "server:no-debug": "SERVER_DEBUG_MODE=0 nodemon",
    "server:no-debug:free": "SERVER_DEBUG_MODE=0 SERVER_SETTLEMENT_START_MODE=free nodemon",
    "dev:client": "vite",
    "dev:server": "nodemon",
    "build": "vite build",
    "preview": "vite preview",
    "start:server": "tsx server/src/index.ts",
    "start:server:no-debug": "SERVER_DEBUG_MODE=0 tsx server/src/index.ts",
    "start:server:no-debug:free": "SERVER_DEBUG_MODE=0 SERVER_SETTLEMENT_START_MODE=free tsx server/src/index.ts",
    "external": "node scripts/start-external.mjs",
    "external:https": "node scripts/start-https-proxy.mjs",
    "perf:monitor": "node scripts/perf-monitor-server.mjs",
    "start-external": "node scripts/start-external.mjs",
    "start:external": "npm run start-external",
    "hosting:tui": "node scripts/hosting-tui.mjs",
    "deploy": "node scripts/hosting-tui.mjs deploy",
    "frontend:deploy": "node scripts/hosting-tui.mjs publish-frontend",
    "haos:deploy": "node scripts/hosting-tui.mjs haos-deploy",
    "typecheck:server": "tsc --noEmit --project tsconfig.server.json",
    "steam:demo:build": "node scripts/build-steam-demo.mjs",
    "steam:demo:electron": "electron desktop/electron/main.mjs",
    "steam:demo:dev": "VITE_DRIFTLANDS_BUILD_TARGET=steam-demo concurrently \"npm:client\" \"npm:steam:demo:electron\"",
    "steam:demo:package:mac": "npm run steam:demo:build && electron-builder --mac dir",
    "steam:demo:package:win": "npm run steam:demo:build && electron-builder --win dir",
    "ipad:build": "VITE_DRIFTLANDS_BUILD_TARGET=ipad VITE_DRIFTLANDS_SERVER_URL=https://driftlands.ddns.net vite build",
    "ipad:sync": "npm run ipad:build && cap sync ios",
    "ipad:open": "cap open ios",
    "publishing:assets": "node scripts/generate-publishing-assets.mjs",
    "art:prompts": "python3 scripts/building_art_pipeline.py prompts",
    "art:process": "python3 scripts/building_art_pipeline.py",
    "art:sheet": "python3 scripts/building_art_pipeline.py contact-sheet"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-ethers": "^1.8.19",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.21.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.3"
  },
  "build": {
    "appId": "io.looperlands.driftlands.demo",
    "productName": "Driftlands",
    "artifactName": "Driftlands-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "desktop/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "dist-server",
        "to": "app/dist-server"
      },
      {
        "from": "public/sounds",
        "to": "app/public/sounds"
      }
    ],
    "directories": {
      "output": "release/steam-demo"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "assets/publishing/icons/driftlands.icns",
      "identity": null,
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "assets/publishing/icons/driftlands.ico",
      "target": [
        "dir"
      ]
    }
  }
}
