{
  "name": "driftlands",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "driftlands": "./scripts/hosting-tui.mjs"
  },
  "scripts": {
    "start": "npm run dev",
    "start:free": "SERVER_SETTLEMENT_START_MODE=free npm run dev",
    "dev": "concurrently \"npm:client\" \"npm:server\"",
    "dev:no-debug": "concurrently \"npm:client\" \"npm:server:no-debug\"",
    "dev:no-debug:free": "concurrently \"npm:client\" \"npm:server:no-debug:free\"",
    "dev:free": "SERVER_SETTLEMENT_START_MODE=free npm run dev",
    "test": "npm run dev",
    "test:unit": "tsx --test src/**/*.test.ts server/**/*.test.ts",
    "client": "vite",
    "server": "nodemon",
    "server:no-debug": "SERVER_DEBUG_MODE=0 nodemon",
    "server:no-debug:free": "SERVER_DEBUG_MODE=0 SERVER_SETTLEMENT_START_MODE=free nodemon",
    "dev:client": "vite",
    "dev:server": "nodemon",
    "build": "vite build",
    "preview": "vite preview",
    "start:server": "tsx server/src/index.ts",
    "start:server:no-debug": "SERVER_DEBUG_MODE=0 tsx server/src/index.ts",
    "start:server:no-debug:free": "SERVER_DEBUG_MODE=0 SERVER_SETTLEMENT_START_MODE=free tsx server/src/index.ts",
    "external": "node scripts/start-external.mjs",
    "external:https": "node scripts/start-https-proxy.mjs",
    "start-external": "node scripts/start-external.mjs",
    "start:external": "npm run start-external",
    "hosting:tui": "node scripts/hosting-tui.mjs",
    "deploy": "node scripts/hosting-tui.mjs deploy",
    "frontend:deploy": "node scripts/hosting-tui.mjs publish-frontend",
    "haos:deploy": "node scripts/hosting-tui.mjs haos-deploy",
    "typecheck:server": "tsc --noEmit --project tsconfig.server.json",
    "art:prompts": "python3 scripts/building_art_pipeline.py prompts",
    "art:process": "python3 scripts/building_art_pipeline.py",
    "art:sheet": "python3 scripts/building_art_pipeline.py contact-sheet"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-ethers": "^1.8.19",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.21.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.3"
  }
}
